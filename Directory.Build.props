<Project>
  <PropertyGroup>
    <!-- Single source of truth for the package version across all projects. Bump here for a release. -->
    <Version>0.0.6</Version>

    <!-- Multi-target LTS + current releases so both net8.0 (LTS) and net10.0 (LTS) consumers can
         install the packages, not just net9.0 (STS). Example apps opt out below and stay
         single-target (see examples/*.csproj) to keep the CI examples job lean. -->
    <TargetFrameworks Condition="!$(MSBuildProjectDirectory.Contains('examples'))">net8.0;net9.0;net10.0</TargetFrameworks>
    <RepositoryUrl>https://github.com/redis/redis-vl-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://github.com/redis/redis-vl-dotnet</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Authors>Steve Lorello</Authors>
    <Company>Redis Inc</Company>
    <PackageTags>redis;redis-search;vector-search;semantic-search;dotnet</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'RedisVL' Or
                            '$(MSBuildProjectName)' == 'RedisVL.Vectorizers.Abstractions' Or
                            '$(MSBuildProjectName)' == 'RedisVL.Vectorizers.ExtensionsAI' Or
                            '$(MSBuildProjectName)' == 'RedisVL.Vectorizers.OpenAI' Or
                            '$(MSBuildProjectName)' == 'RedisVL.Vectorizers.HuggingFace' Or
                            '$(MSBuildProjectName)' == 'RedisVL.Vectorizers.Cohere' Or
                            '$(MSBuildProjectName)' == 'RedisVL.Rerankers.Abstractions' Or
                            '$(MSBuildProjectName)' == 'RedisVL.Rerankers.Cohere' Or
                            '$(MSBuildProjectName)' == 'RedisVL.Rerankers.Onnx' Or
                            '$(MSBuildProjectName)' == 'RedisVL.Vectorizers.Onnx' Or
                            '$(MSBuildProjectName)' == 'RedisVL.Connectors.VectorData'">
    <IsPackable>true</IsPackable>
    <!-- Ship XML documentation in every package so consumers get IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == ''">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\" 
          Link="README.md"
          Visible="false" />
  </ItemGroup>
</Project>
